include("lib/http.bzg");
var server = http(8000);

// ==========================================
// HTTP EVENT HANDLERS
// ==========================================

server.get = function (path, data){
    print("get loc:" + path );

    if(path == "/"){
        server.sendFile("public/index.html");
    }
    else{
        server.sendFile("public/404.html");
    }
};

// ==========================================
// WEBSOCKET (WS) EVENT HANDLERS
// ==========================================
//
// The server is a plain relay: it keeps NO state and does NO parsing.
// Whatever one client sends is broadcast to every connected client.
// Usernames, join/leave notices and the online list are handled
// by the clients themselves (see public/index.html).

server.onConnect = function (clientId) {
    print("WebSocket connected! Client ID: " + clientId);
};

server.onData = function (message, clientId) {
    // Pictures arrive as many small packets, so only the sender is printed here.
    print("Received from Client " + clientId);
    server.sendAll(message);
};

server.onDisconnect = function (clientId) {
    print("WebSocket disconnected! Client ID: " + clientId);
};

server.run();
