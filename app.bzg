include("lib/http.bzg");
var server = http(8000);

// ==========================================
// CHATTERBOX SERVER  (everything lives in this one file, no Node.js)
// ==========================================
//
// 1. Serves the web page            (server.get)
// 2. Relays live chat to everyone   (server.onData -> sendAll)
// 3. Accounts: sign up / log in     (SIGNUP, LOGIN packets)
// 4. Chat history                   (SAVE, HISTORY packets)
//
// Accounts and history ride on the same WebSocket as the chat, so only port 8000
// is needed (for ngrok:  ngrok http 8000).
//
// Packets use the same shape as the rest of the app:  TYPE|id|name|payload
//
//   client -> server
//     SIGNUP|id|username|password
//     LOGIN|id|username|password
//     HISTORY|id||
//     SAVE|id|channel|timestamp|text        (payload is  timestamp|text)
//
//   server -> that one client
//     AUTHOK|id|username|
//     AUTHERR|id|message|
//     HIST|id|user|channel|timestamp|text   (one per saved message)
//     HISTEND|id||
//     SAVEERR|id|message|
//
// Anything else is a live chat packet and is broadcast to everyone, as before.
//
// Personal project: passwords are plain text and there is no real security.

// ------------------------------------------
// SETTINGS
// ------------------------------------------
var CHANNELS = ["general", "random", "help", "memes"];   // keep in sync with public/app.js
var MAX_TEXT = 300;               // same limit as the message box
var HISTORY_PER_CHANNEL = 100;    // how many past messages a person gets on login
var MAX_LOG = 2000;               // saved messages kept in total (oldest dropped)

// Saving to disk. Accounts and messages are kept in memory; with PERSIST = true they
// are also written to the two files below and read back when the server starts.
// This needs file functions in the interpreter: see fileRead / fileWrite at the bottom.
var PERSIST = true;
var USERS_FILE = "database/users.txt";
var LOGS_FILE = "database/chatlogs.txt";

// ------------------------------------------
// DATA (parallel lists, entry n of each list belongs together)
// ------------------------------------------
var userName = [];      // username
var userPass = [];      // password

var sessId = [];        // browser tab id that logged in
var sessName = [];      // ...and the username it logged in as

var logCh = [];         // channel
var logUser = [];       // who wrote it
var logTs = [];         // timestamp (ms since 1970, supplied by the sender's browser)
var logText = [];       // the message
var logN = 0;           // how many messages are stored (never more than MAX_LOG)
var logHead = 0;        // slot of the oldest message once the list is full (ring buffer)

// ------------------------------------------
// SMALL HELPERS
// ------------------------------------------
// NOTE: Bonezegei strings and arrays have NO methods (no .indexOf, .substring,
// .length, .push, .toLowerCase ...). Calling one gives
//   "Attempt to call method on non-object type".
// Use sizeof(x), substr(s, start, len), s[i] and arr[sizeof(arr)] = value instead.
//
// Also: a function must be defined ABOVE the functions that call it, otherwise the
// call fails with "Undefined variable <name>". Keep helpers at the top.

var UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
var LOWER = "abcdefghijklmnopqrstuvwxyz";

// Position of the first `ch` in `s` at or after `from`, or -1.
function indexOfChar(s, ch, from) {
    var i = from;
    var n = sizeof(s);
    while (i < n) {
        if (s[i] == ch) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// lower-case copy of a string (no built-in toLowerCase)
function lower(s) {
    var out = "";
    var i = 0;
    var n = sizeof(s);
    while (i < n) {
        var c = s[i];
        var r = c;
        var j = 0;
        while (j < 26) {
            if (UPPER[j] == c) {
                r = LOWER[j];
            }
            j = j + 1;
        }
        out = out + r;
        i = i + 1;
    }
    return out;
}

// Splits  TYPE|id|name|payload  into 4 parts. The last part keeps any extra "|".
function parsePacket(data) {
    var parts = [];
    var rest = data;
    var i = 0;
    while (i < 3) {
        var k = indexOfChar(rest, "|", 0);
        if (k < 0) {
            parts[sizeof(parts)] = rest;
            rest = "";
        } else {
            parts[sizeof(parts)] = substr(rest, 0, k);
            rest = substr(rest, k + 1);
        }
        i = i + 1;
    }
    parts[sizeof(parts)] = rest;
    return parts;
}

// Splits  timestamp|text  into 2 parts.
function parsePair(data) {
    var k = indexOfChar(data, "|", 0);
    if (k < 0) {
        return [data, ""];
    }
    return [substr(data, 0, k), substr(data, k + 1)];
}

function reply(clientId, type, id, name, payload) {
    server.send(clientId, type + "|" + id + "|" + name + "|" + payload);
}

function findUser(name) {
    var wanted = lower(name);
    var i = 0;
    while (i < sizeof(userName)) {
        if (lower(userName[i]) == wanted) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

function findSession(id) {
    var i = 0;
    while (i < sizeof(sessId)) {
        if (sessId[i] == id) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

function startSession(id, name) {
    var at = findSession(id);
    if (at < 0) {
        sessId[sizeof(sessId)] = id;
        sessName[sizeof(sessName)] = name;
    } else {
        sessName[at] = name;
    }
}

function channelKnown(ch) {
    var i = 0;
    while (i < sizeof(CHANNELS)) {
        if (CHANNELS[i] == ch) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Message list is a ring buffer: arrays can only grow, so once MAX_LOG messages are
// stored the oldest slot is overwritten. logSlot(k) = slot of the k-th oldest message.
function logSlot(k) {
    var pos = logHead + k;
    return pos % MAX_LOG;
}

function addLog(channel, user, ts, text) {
    var slot = 0;
    if (logN < MAX_LOG) {
        slot = logN;
        logN = logN + 1;
    } else {
        slot = logHead;
        var nextHead = logHead + 1;
        logHead = nextHead % MAX_LOG;
    }
    logCh[slot] = channel;
    logUser[slot] = user;
    logTs[slot] = ts;
    logText[slot] = text;
}

// ------------------------------------------
// SAVING TO DISK (only used when PERSIST = true)
// ------------------------------------------
// users.txt     one account per line:  username|password
// chatlogs.txt  one message per line:  channel|user|timestamp|text
//
// These two functions are the only place that touches files. If your Bonezegei
// build names its file functions differently, change them here and nowhere else.
function fileRead(path) {
    return readFile(path);          // should return the whole file as text ("" if missing)
}

function fileWrite(path, text) {
    writeFile(path, text);          // should replace the file with `text`
}

function saveUsers() {
    if (!PERSIST) {
        return;
    }
    var out = "";
    var i = 0;
    while (i < sizeof(userName)) {
        out = out + userName[i] + "|" + userPass[i] + "\n";
        i = i + 1;
    }
    fileWrite(USERS_FILE, out);
}

function saveLogs() {
    if (!PERSIST) {
        return;
    }
    var out = "";
    var i = 0;
    while (i < logN) {
        var at = logSlot(i);
        out = out + logCh[at] + "|" + logUser[at] + "|" + logTs[at] + "|" + logText[at] + "\n";
        i = i + 1;
    }
    fileWrite(LOGS_FILE, out);
}

// ------------------------------------------
// ACCOUNTS
// ------------------------------------------
function doSignup(clientId, id, name, password) {
    if (sizeof(name) < 2 || sizeof(name) > 16) {
        reply(clientId, "AUTHERR", id, "Username needs 2 to 16 characters.", "");
        return;
    }
    if (sizeof(password) < 1) {
        reply(clientId, "AUTHERR", id, "Please choose a password.", "");
        return;
    }
    if (findUser(name) >= 0) {
        reply(clientId, "AUTHERR", id, "That username is already registered.", "");
        return;
    }

    userName[sizeof(userName)] = name;
    userPass[sizeof(userPass)] = password;
    saveUsers();
    print("New user confirmed: " + name);

    startSession(id, name);
    reply(clientId, "AUTHOK", id, name, "");
}

function doLogin(clientId, id, name, password) {
    var at = findUser(name);
    // (|| and && do not short-circuit in BSL, so check the index first on its own)
    if (at < 0) {
        reply(clientId, "AUTHERR", id, "Wrong username or password.", "");
        return;
    }
    if (userPass[at] != password) {
        reply(clientId, "AUTHERR", id, "Wrong username or password.", "");
        return;
    }
    startSession(id, userName[at]);
    reply(clientId, "AUTHOK", id, userName[at], "");
}

// ------------------------------------------
// CHAT HISTORY
// ------------------------------------------
function doSave(clientId, id, channel, payload) {
    var s = findSession(id);
    if (s < 0) {
        reply(clientId, "SAVEERR", id, "Please log in again.", "");
        return;
    }
    var pair = parsePair(payload);
    var text = pair[1];
    if (sizeof(text) > MAX_TEXT) {
        text = substr(text, 0, MAX_TEXT);
    }
    if (!channelKnown(channel) || sizeof(text) < 1) {
        return;
    }
    if (substr(text, 0, 5) == "[img]") {
        text = " " + text;     // typed text can't pretend to be a saved picture
    }

    addLog(channel, sessName[s], pair[0], text);
    saveLogs();
}

function doHistory(clientId, id) {
    if (findSession(id) < 0) {
        reply(clientId, "SAVEERR", id, "Please log in again.", "");
        reply(clientId, "HISTEND", id, "", "");
        return;
    }
    var c = 0;
    while (c < sizeof(CHANNELS)) {
        var ch = CHANNELS[c];

        // How many saved messages does this channel have?
        var count = 0;
        var i = 0;
        while (i < logN) {
            if (logCh[logSlot(i)] == ch) {
                count = count + 1;
            }
            i = i + 1;
        }

        // Send only the newest HISTORY_PER_CHANNEL of them, oldest first.
        var skip = count - HISTORY_PER_CHANNEL;
        var seen = 0;
        i = 0;
        while (i < logN) {
            var at = logSlot(i);
            if (logCh[at] == ch) {
                if (seen >= skip) {
                    reply(clientId, "HIST", id, logUser[at], ch + "|" + logTs[at] + "|" + logText[at]);
                }
                seen = seen + 1;
            }
            i = i + 1;
        }
        c = c + 1;
    }
    reply(clientId, "HISTEND", id, "", "");
}

// ------------------------------------------
// LOADING FROM DISK (only used when PERSIST = true)
// ------------------------------------------
// Takes the first line off `text`; returns [line, restOfText].
function nextLine(text) {
    var nl = indexOfChar(text, "\n", 0);
    var line = text;
    var rest = "";
    if (nl >= 0) {
        line = substr(text, 0, nl);
        rest = substr(text, nl + 1);
    }
    var n = sizeof(line);
    if (n > 0) {
        if (line[n - 1] == "\r") {
            line = substr(line, 0, n - 1);
        }
    }
    return [line, rest];
}


// ------------------------------------------
// PICTURES (saved so they come back after a restart / re-login)
// ------------------------------------------
// While a picture is being sent (IMGH header + IMGC pieces, still relayed live to
// everyone) the server collects the pieces. When the last one arrives it writes
//     database/images/<picId>.txt      line 1: mime|bytes     rest: the base64 data
// and adds a normal chat-log entry whose text is   [img]picId,mime,bytes,width,height
// A client asks for a saved picture with IMGGET and gets PICH + PICC packets back
// (to that client only). Pictures are only loaded when they scroll into view.
var IMAGES_DIR = "database/images/";
var PIC_CHUNK = 1500;
var IMG_MARK = "[img]";
var ID_CHARS = "abcdefghijklmnopqrstuvwxyz0123456789";
var DIGITS = "0123456789";

var pendId = [];      // picId being received ("" = free slot)
var pendOwner = [];   // tab id of the sender
var pendUser = [];
var pendCh = [];
var pendMime = [];
var pendSize = [];
var pendW = [];
var pendH = [];
var pendTs = [];
var pendTotal = [];   // number of pieces, kept as text
var pendGot = [];     // pieces received so far
var pendData = [];    // base64 collected so far

// every field of  a|b|c|...  (the last field keeps nothing special: plain split)
function splitAll(s) {
    var out = [];
    var rest = s;
    var k = indexOfChar(rest, "|", 0);
    while (k >= 0) {
        out[sizeof(out)] = substr(rest, 0, k);
        rest = substr(rest, k + 1);
        k = indexOfChar(rest, "|", 0);
    }
    out[sizeof(out)] = rest;
    return out;
}

// true if `s` is 1..maxLen characters, all taken from `allowed`
function onlyChars(s, allowed, maxLen) {
    var n = sizeof(s);
    if (n < 1) {
        return false;
    }
    if (n > maxLen) {
        return false;
    }
    var i = 0;
    while (i < n) {
        if (indexOfChar(allowed, s[i], 0) < 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

function mimeOk(m) {
    return m == "image/jpeg" || m == "image/png" || m == "image/gif" || m == "image/webp";
}

function findPending(picId) {
    var i = 0;
    while (i < sizeof(pendId)) {
        if (pendId[i] == picId) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

function freePending(i) {
    pendId[i] = "";
    pendOwner[i] = "";
    pendData[i] = "";
}

function newPendingSlot() {
    var i = 0;
    while (i < sizeof(pendId)) {
        if (pendId[i] == "") {
            return i;
        }
        i = i + 1;
    }
    return sizeof(pendId);
}

// IMGH|id|name|channel|picId|packets|mime|bytes|width|height|timestamp
function picHeader(id, payload) {
    var s = findSession(id);
    if (s < 0) {
        return;
    }
    // a sender only ever sends one picture at a time: drop anything it left unfinished
    var j = 0;
    while (j < sizeof(pendId)) {
        if (pendOwner[j] == id) {
            freePending(j);
        }
        j = j + 1;
    }
    var f = splitAll(payload);
    if (sizeof(f) < 7) {
        return;
    }
    if (!channelKnown(f[0])) {
        return;
    }
    if (!onlyChars(f[1], ID_CHARS, 24)) {
        return;
    }
    if (!onlyChars(f[2], DIGITS, 3)) {
        return;
    }
    if (!mimeOk(f[3])) {
        return;
    }
    if (!onlyChars(f[4], DIGITS, 6)) {
        return;
    }
    if (!onlyChars(f[5], DIGITS, 4)) {
        return;
    }
    if (!onlyChars(f[6], DIGITS, 4)) {
        return;
    }
    var ts = "0";
    if (sizeof(f) > 7) {
        if (onlyChars(f[7], DIGITS, 15)) {
            ts = f[7];
        }
    }
    var at = newPendingSlot();
    pendId[at] = f[1];
    pendOwner[at] = id;
    pendUser[at] = sessName[s];
    pendCh[at] = f[0];
    pendTotal[at] = f[2];
    pendMime[at] = f[3];
    pendSize[at] = f[4];
    pendW[at] = f[5];
    pendH[at] = f[6];
    pendTs[at] = ts;
    pendGot[at] = 0;
    pendData[at] = "";
}

// IMGC|id|name|picId|index|base64data
function picChunk(id, payload) {
    var k1 = indexOfChar(payload, "|", 0);
    if (k1 < 0) {
        return;
    }
    var k2 = indexOfChar(payload, "|", k1 + 1);
    if (k2 < 0) {
        return;
    }
    var picId = substr(payload, 0, k1);
    var index = substr(payload, k1 + 1, k2 - k1 - 1);
    var at = findPending(picId);
    if (at < 0) {
        return;
    }
    if (pendOwner[at] != id) {
        return;
    }
    // pieces arrive in order; anything else means the picture is damaged
    if (index != ("" + pendGot[at])) {
        freePending(at);
        return;
    }
    pendData[at] = pendData[at] + substr(payload, k2 + 1);
    pendGot[at] = pendGot[at] + 1;

    if (("" + pendGot[at]) == pendTotal[at]) {
        if (!PERSIST) {
            freePending(at);       // pictures are only kept when saving is on
            return;
        }
        fileWrite(IMAGES_DIR + picId + ".txt", pendMime[at] + "|" + pendSize[at] + "\n" + pendData[at]);
        addLog(pendCh[at], pendUser[at], pendTs[at],
               IMG_MARK + picId + "," + pendMime[at] + "," + pendSize[at] + "," + pendW[at] + "," + pendH[at]);
        saveLogs();
        print("Saved picture " + picId + " from " + pendUser[at]);
        freePending(at);
    }
}

// IMGGET|id||picId  ->  PICH|id||picId|packets|mime|bytes  then PICC|id||picId|index|data ...
function sendPicture(clientId, id, picId) {
    if (findSession(id) < 0) {
        reply(clientId, "PICERR", id, picId, "");
        return;
    }
    if (!onlyChars(picId, ID_CHARS, 24)) {
        reply(clientId, "PICERR", id, picId, "");
        return;
    }
    var text = fileRead(IMAGES_DIR + picId + ".txt");
    if (sizeof(text) < 1) {
        reply(clientId, "PICERR", id, picId, "");
        return;
    }
    var first = nextLine(text);
    var info = parsePair(first[0]);        // mime | bytes
    var data = first[1];
    var n = sizeof(data);

    var total = 0;
    var p = 0;
    while (p < n) {
        p = p + PIC_CHUNK;
        total = total + 1;
    }
    reply(clientId, "PICH", id, picId, "" + total + "|" + info[0] + "|" + info[1]);
    var i = 0;
    p = 0;
    while (i < total) {
        reply(clientId, "PICC", id, picId, "" + i + "|" + substr(data, p, PIC_CHUNK));
        p = p + PIC_CHUNK;
        i = i + 1;
    }
}

function loadAll() {
    if (!PERSIST) {
        return;
    }
    var text = fileRead(USERS_FILE);
    while (sizeof(text) > 0) {
        var l1 = nextLine(text);
        text = l1[1];
        if (sizeof(l1[0]) > 0) {
            var u = parsePair(l1[0]);       // username | password (password may contain "|")
            userName[sizeof(userName)] = u[0];
            userPass[sizeof(userPass)] = u[1];
        }
    }

    text = fileRead(LOGS_FILE);
    while (sizeof(text) > 0) {
        var l2 = nextLine(text);
        text = l2[1];
        if (sizeof(l2[0]) > 0) {
            var m = parsePacket(l2[0]);     // channel | user | timestamp | text
            addLog(m[0], m[1], m[2], m[3]);
        }
    }
    print("Loaded " + sizeof(userName) + " user(s) and " + logN + " saved message(s).");
}

loadAll();

// ==========================================
// HTTP EVENT HANDLERS
// ==========================================

server.get = function (path, data){
    print("get loc:" + path );

    if(path == "/"){
        server.sendFile("public/index.html");
    }
    else if(path == "/style.css"){
        server.sendFile("public/style.css");
    }
    else if(path == "/app.js"){
        server.sendFile("public/app.js");
    }
    else{
        server.sendFile("public/404.html");
    }
};

// ==========================================
// WEBSOCKET (WS) EVENT HANDLERS
// ==========================================

server.onConnect = function (clientId) {
    print("WebSocket connected! Client ID: " + clientId);

    // Send a welcome message to this specific client
    server.send(clientId, "Welcome toWebSocket server!");
};

server.onData = function (message, clientId) {
    // (the console shows only short packets; pictures and passwords are not printed)

    // Echo the message back to the sender
    //server.send(clientId, "Echo: " + message);
    //server.send(clientId, message);

    // Work out the packet type (the text before the first "|").
    var k = indexOfChar(message, "|", 0);
    var type = message;
    if (k >= 0) {
        type = substr(message, 0, k);
    }

    // Account and history packets are answered to the sender only, never broadcast.
    // Their content is not printed (it holds passwords).
    if (type == "SIGNUP" || type == "LOGIN") {
        var a = parsePacket(message);          // type, id, username, password
        if (type == "SIGNUP") {
            doSignup(clientId, a[1], a[2], a[3]);
        } else {
            doLogin(clientId, a[1], a[2], a[3]);
        }
    }
    else if (type == "SAVE") {
        var b = parsePacket(message);          // type, id, channel, timestamp|text
        doSave(clientId, b[1], b[2], b[3]);
    }
    else if (type == "HISTORY") {
        var c = parsePacket(message);
        doHistory(clientId, c[1]);
    }
    else if (type == "IMGGET") {
        var g = parsePacket(message);          // type, id, (name), picId
        sendPicture(clientId, g[1], g[3]);
    }
    else {
        // Pictures are saved on the way past, then relayed live like everything else.
        if (type == "IMGH") {
            var ih = parsePacket(message);     // type, id, name, channel|picId|...
            picHeader(ih[1], ih[3]);
        }
        if (type == "IMGC") {
            var ic = parsePacket(message);     // type, id, name, picId|index|data
            picChunk(ic[1], ic[3]);
        }
        // Live chat: broadcast it to everyone connected.
        if (type != "IMGC") {
            print("Received from Client " + clientId + ": " + type);
        }
        server.sendAll("User " + clientId + " says: " + message);
    }
};

server.onDisconnect = function (clientId) {
    print("WebSocket disconnected! Client ID: " + clientId);
};

server.run();
