{
  "name": "Socket",
  "version": "1.0.1",
  "functions": {
    "http": {
      "info": "http object",
      "params": "port",
      "req_params": 1,
      "methods": {
        "get": {
          "info": "HTTP GET Callback",
          "params": "path, data",
          "req_params": 2
        },
        "post": {
          "info": "HTTP POST Callback",
          "params": "path, data",
          "req_params": 2
        },
        "sendResponse": {
          "info": "HTTP send Response to Client",
          "params": "message, type(ex: text/html,...), code (ex: 200, 404)",
          "req_params": 3
        },
        "sendFile": {
          "info": "HTTP send file to Client",
          "params": "filename",
          "req_params": 1
        },
        
        "onConnect": {
          "info": "Websocket Client onConnect Callback",
          "params": "clientID/Index",
          "req_params": 1
        }, 
        "onData": {
          "info": "Websocket Client onData Callback",
          "params": "Data , clientID ",
          "req_params": 2
        },
        "onDisconnect": {
          "info": "Websocket Client onDisconnect Callback",
          "params": "clientID ",
          "req_params": 1
        },
        "send": {
          "info": "Websocket send data to client",
          "params": "clientID, message/data",
          "req_params": 2
        },
        "sendAll": {
          "info": "Websocket send data to all clients",
          "params": "message/data",
          "req_params": 1
        },
    
        "run": {
          "info": "Run Server on Infinite Loop",
          "params": "",
          "req_params": 0
        }
    }
  }
}

